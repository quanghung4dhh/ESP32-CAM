ESP_STREAM_URL=http://<IP-ESP32>:81/stream

# Telegram (bỏ trống nếu không dùng)
TELEGRAM_BOT_TOKEN=<token từ @BotFather>
TELEGRAM_CHAT_ID=<chat id>

# Discord (bỏ trống nếu không dùng): Webhook URL của kênh nhận thông báo.
# URL này là bí mật như mật khẩu: không commit, không gửi cho người khác.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# Discord bot - nhận lệnh /snapshot /status /on /off (bỏ trống nếu không dùng).
# Khác với webhook ở trên: webhook chỉ GỬI cảnh báo, bot mới NHẬN lệnh.
DISCORD_BOT_TOKEN=<token của bot, giữ bí mật>
DISCORD_GUILD_ID=<ID server Discord, giúp lệnh hiện ngay>
DISCORD_ALLOWED_USER_IDS=<ID Discord của bạn, nhiều người cách nhau bằng dấu phẩy>
